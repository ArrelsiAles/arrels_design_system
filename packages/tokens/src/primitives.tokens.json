    "indigo": {
      "100": { "$value": { "colorSpace": "srgb", "components": [0.8784, 0.8902, 0.9686] }, "$extensions": { "org.arrels.hex": "#E0E3F7" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.5804, 0.6314, 1] }, "$extensions": { "org.arrels.hex": "#94A1FF" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.302, 0.349, 0.7412] }, "$extensions": { "org.arrels.hex": "#4D59BD" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.1451, 0.1686, 0.3137] }, "$extensions": { "org.arrels.hex": "#252B50" } }
    }
  },
  "dimension": {
    "$type": "dimension",
    "space": {
      "0": { "$value": { "value": 0, "unit": "px" } },
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "10": { "$value": { "value": 40, "unit": "px" } },
      "12": { "$value": { "value": 48, "unit": "px" } },
      "16": { "$value": { "value": 64, "unit": "px" } },
      "20": { "$value": { "value": 80, "unit": "px" } },
      "24": { "$value": { "value": 96, "unit": "px" } }
    },
    "radius": {
      "sm": { "$value": { "value": 8, "unit": "px" } },
      "md": { "$value": { "value": 12, "unit": "px" } },
      "lg": { "$value": { "value": 20, "unit": "px" } },
      "xl": { "$value": { "value": 28, "unit": "px" } },
      "pill": { "$value": { "value": 999, "unit": "px" } }
    },
    "control": {
      "sm": { "$value": { "value": 36, "unit": "px" } },
      "md": { "$value": { "value": 44, "unit": "px" } },
      "lg": { "$value": { "value": 48, "unit": "px" } }
    },
    "icon": {
      "sm": { "$value": { "value": 16, "unit": "px" } },
      "md": { "$value": { "value": 20, "unit": "px" } },
      "lg": { "$value": { "value": 24, "unit": "px" } },
      "xl": { "$value": { "value": 32, "unit": "px" } }
    },
    "border": { "default": { "$value": { "value": 0.5, "unit": "px" } }, "focus": { "$value": { "value": 1, "unit": "px" } } },
    "breakpoint": {
      "phone": { "$value": { "value": 375, "unit": "px" } },
      "tablet": { "$value": { "value": 768, "unit": "px" } },
      "desktop": { "$value": { "value": 1024, "unit": "px" } },
      "wide": { "$value": { "value": 1440, "unit": "px" } }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "ui": { "$value": ["Inter", "Helvetica Neue", "Arial", "sans-serif"] } },
    "weight": { "$type": "fontWeight", "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 } }
  },
  "motion": {
    "duration": { "$type": "duration", "instant": { "$value": { "value": 80, "unit": "ms" } }, "fast": { "$value": { "value": 160, "unit": "ms" } }, "standard": { "$value": { "value": 240, "unit": "ms" } }, "complex": { "$value": { "value": 360, "unit": "ms" } } },
    "easing": { "$type": "cubicBezier", "enter": { "$value": [0.16, 1, 0.3, 1] }, "exit": { "$value": [0.4, 0, 1, 1] } }
  }
}

