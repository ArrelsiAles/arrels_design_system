      "400": { "$value": { "colorSpace": "srgb", "components": [0.9373, 0.4941, 0.6784] }, "$extensions": { "org.arrels.hex": "#EF7EAD" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.7647, 0.2824, 0.502] }, "$extensions": { "org.arrels.hex": "#C34880" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.7176, 0.2078, 0.4392] }, "$extensions": { "org.arrels.hex": "#B73570" } },
