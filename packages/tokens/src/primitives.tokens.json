    },
    "red": {
      "100": { "$value": { "colorSpace": "srgb", "components": [0.9529, 0.8745, 0.8902] }, "$extensions": { "org.arrels.hex": "#F3DFE3" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.9255, 0.4941, 0.5647] }, "$extensions": { "org.arrels.hex": "#EC7E90" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.7059, 0.2784, 0.3451] }, "$extensions": { "org.arrels.hex": "#B44758" } },
