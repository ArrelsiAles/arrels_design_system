---
import {
  Activity,
  ArrowRight,
  Bell,
  CalendarDays,
  Check,
  ChevronDown,
  CircleQuestionMark,
  Clock3,
  Ellipsis,
  FileText,
  Grid2x2,
  HeartHandshake,
  LayoutDashboard,
  MapPin,
  Menu,
  MessageCircle,
  Moon,
  Plus,
  Search,
  Settings,
  ShieldCheck,
  Sparkles,
  Sun,
  TriangleAlert,
  Users,
} from "@lucide/astro";
import "../styles/global.css";

const navigation = [
  { href: "#identity", label: "Identitat", icon: HeartHandshake },
  { href: "#foundations", label: "Foundations", icon: Grid2x2 },
  { href: "#components", label: "Components", icon: Sparkles },
  { href: "#admin", label: "Admin", icon: LayoutDashboard },
  { href: "#key-screens", label: "Pantalles clau", icon: CalendarDays },
  { href: "#mobile", label: "Mobile", icon: Activity },
];

const tokenGroups = [
  {
    title: "Superfícies",
    tokens: [
      { name: "Canvas", variable: "--canvas" },
      { name: "Surface", variable: "--surface" },
      { name: "Raised", variable: "--surface-raised" },
      { name: "Subtle", variable: "--surface-subtle" },
    ],
  },
  {
    title: "Contingut",
    tokens: [
      { name: "Text primary", variable: "--text" },
      { name: "Text secondary", variable: "--text-muted" },
      { name: "Border", variable: "--border" },
      { name: "Accent", variable: "--accent" },
    ],
  },
  {
    title: "Estats",
    tokens: [
      { name: "Success", variable: "--success" },
      { name: "Warning", variable: "--warning" },
      { name: "Danger", variable: "--danger" },
      { name: "Information", variable: "--info" },
    ],
  },
];

const schedule = [
  {
    time: "08:30",
    service: "Servei domiciliari",
    zone: "Zona Nord",
    worker: "Equip 04",
    state: "En curs",
    tone: "success",
  },
  {
    time: "09:15",
    service: "Suport personal",
    zone: "Centre",
    worker: "Equip 11",
    state: "Confirmada",
    tone: "info",
  },
  {
    time: "10:00",
    service: "Acompanyament",
    zone: "Llevant",
    worker: "Pendent",
    state: "Per assignar",
    tone: "warning",
  },
  {
    time: "11:30",
    service: "Atenció directa",
    zone: "Ponent",
    worker: "Equip 07",
    state: "Revisar",
    tone: "danger",
  },
];
---

<!doctype html>
<html lang="ca" data-language="ca" data-route="future-rose" data-mode="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Laboratori visual de la identitat d'Arrels i Ales i ARRELS360."
    />
    <title>Arrels Design System · Laboratori visual</title>
    <script is:inline>
      (() => {
        try {
          const route = localStorage.getItem("arrels-route");
          const mode = localStorage.getItem("arrels-mode");
          const language = localStorage.getItem("arrels-language");
          const allowedRoutes = ["roots", "future", "future-rose"];
          if (route && allowedRoutes.includes(route)) {
            document.documentElement.dataset.route = route;
          } else {
            localStorage.setItem("arrels-route", "future-rose");
          }
          if (mode) document.documentElement.dataset.mode = mode;
          if (language === "es") {
            document.documentElement.dataset.language = "es";
            document.documentElement.lang = "es";
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Anar al contingut</a>

    <header class="lab-header">
      <a class="lab-brand" href="#identity" aria-label="Arrels Design System">
        <span class="brand-symbol" aria-hidden="true"><i></i></span>
        <span class="brand-wordmark">
          <strong>Arrels i Ales</strong>
          <small>ARRELS360 · Design system</small>
        </span>
      </a>

      <div class="theme-lab" aria-label="Selector de ruta visual">
        <span class="theme-label">Ruta</span>
        <div class="route-switcher" role="group" aria-label="Ruta creativa">
          <button type="button" data-route-option="roots">
            <i class="route-dot roots-dot"></i>
            <span>Arrels humanes</span>
          </button>
          <button type="button" data-route-option="future">
            <i class="route-dot future-dot"></i>
            <span>Precisió futura</span>
          </button>
          <button type="button" data-route-option="future-rose">
            <i class="route-dot future-rose-dot"></i>
            <span>Precisió rosa</span>
          </button>
        </div>
        <div class="language-switcher" role="group" aria-label="Idioma">
          <button type="button" data-language-option="ca">CA</button>
          <button type="button" data-language-option="es">ES</button>
        </div>
        <button
          class="mode-toggle"
          type="button"
          aria-label="Canviar entre mode clar i fosc"
          title="Canviar mode"
        >
          <Sun class="sun-icon" size={17} aria-hidden="true" />
          <Moon class="moon-icon" size={17} aria-hidden="true" />
        </button>
      </div>
    </header>

    <div class="lab-layout">
      <aside class="docs-sidebar">
        <nav aria-label="Seccions de la guia">
          <p>Explorar</p>
          {
            navigation.map(({ href, label, icon: Icon }) => (
              <a href={href}>
                <Icon size={17} stroke-width={1.8} aria-hidden="true" />
                {label}
              </a>
            ))
          }
        </nav>
        <div class="sidebar-note">
          <span>Estat</span>
          <strong><i></i> Exploració activa</strong>
          <p>Canvia de ruta a dalt. El contingut no es mou; només canvia el sistema visual.</p>
        </div>
      </aside>

      <main id="content">
        <section class="identity-hero" id="identity">
          <div class="hero-copy">
            <p class="eyebrow">Identitat compartida · v0.2</p>
            <h1>
              Cuidam persones.<br />
              <span>Connectam tot el que les sosté.</span>
            </h1>
            <p class="hero-description">
              Arrels i Ales aporta la mirada humana. ARRELS360 transforma aquesta
              experiència en una eina clara, coordinada i segura.
            </p>
            <div class="hero-actions">
              <button class="button primary" type="button">
                Veure el sistema
                <ArrowRight size={17} aria-hidden="true" />
              </button>
              <button class="button secondary" type="button">Principis de marca</button>
            </div>
          </div>

          <div class="brand-canvas" aria-label="Relació entre marques">
            <div class="brand-canvas-top">
              <span>Arquitectura de marca</span>
              <span class="live-indicator"><i></i> En viu</span>
            </div>
            <div class="master-lockup">
              <span class="brand-symbol large" aria-hidden="true"><i></i></span>
              <div>
                <strong>Arrels i Ales</strong>
                <span>Cuidam · Acompanyam · Avançam</span>
              </div>
            </div>
            <div class="relationship-line"><span></span><i></i><span></span></div>
            <div class="product-lockup">
              <div>
                <span>Producte digital</span>
                <strong>ARRELS<span>360</span></strong>
              </div>
              <span class="product-orbit" aria-hidden="true"></span>
            </div>
          </div>
        </section>

        <section class="section logo-concepts-section" aria-labelledby="logo-concepts-title" hidden>
          <div class="section-intro split">
            <div>
              <p class="eyebrow">Reinterpretació del logotip</p>
              <h2 id="logo-concepts-title">Dues formes de preservar l’origen.</h2>
            </div>
            <p>
              Les dues versions recuperen les persones majors, la mà agafada i
              el bastó del logotip original. El cor posa l’accent en l’afecte;
              el cercle, en la protecció i la continuïtat.
            </p>
          </div>

          <div class="logo-concept-grid">
            <article>
              <div class="concept-meta">
                <span>01</span>
                <div>
                  <h3>El cor de l’origen</h3>
                  <p>Les mans construeixen un cor al voltant de les dues persones majors agafades de la mà.</p>
                </div>
              </div>
              <img
                src="/logo-concepts/concept-01c-original-elders-heart.png"
                width="1920"
                height="819"
                alt="El cor de l’origen amb dues persones majors dins unes mans en forma de cor"
                loading="lazy"
              />
            </article>

            <article>
              <div class="concept-meta">
                <span>02</span>
                <div>
                  <h3>El cercle de l’origen</h3>
                  <p>La mateixa escena queda protegida per un cercle continu construït des de les mans.</p>
                </div>
              </div>
              <img
                src="/logo-concepts/concept-02-original-elders-circle.png"
                width="1918"
                height="820"
                alt="El cercle de l’origen amb dues persones majors protegides per unes mans dins un cercle"
                loading="lazy"
              />
            </article>
          </div>
        </section>

        <section class="section iconography-section" aria-labelledby="iconography-title" hidden>
          <div class="section-intro split">
            <div>
              <p class="eyebrow">Iconografia de marca</p>
              <h2 id="iconography-title">El cor també viu en negatiu.</h2>
            </div>
            <p>
              La versió blanca conserva el mateix dibuix i converteix el rosa
              en superfície de marca. No és una proposta diferent, sinó una
              aplicació d’“El cor de l’origen” per a suports amb fons rosa.
            </p>
          </div>

          <div class="negative-usage-grid">
            <figure class="negative-mark-preview">
              <img
                src="/logo-variants/el-cor-de-l-origen-negative-pink.png"
                width="1254"
                height="1254"
                alt="Versió negativa d’El cor de l’origen en blanc sobre rosa"
                loading="lazy"
              />
              <figcaption>
                <span>Versió negativa</span>
                <strong>Blanc sobre rosa Arrels</strong>
              </figcaption>
            </figure>

            <div class="negative-usage-rules">
              <article>
                <span>01</span>
                <div>
                  <h3>Quan emprar-la</h3>
                  <p>Uniformes rosa, senyalística, vehicles, acreditacions, avatars i peces editorials amb una superfície rosa contínua.</p>
                </div>
              </article>
              <article>
                <span>02</span>
                <div>
                  <h3>Com reproduir-la</h3>
                  <p>Cor, mans, persones, bastó i wordmark sempre en blanc pur. Els espais interiors deixen veure el mateix rosa del fons.</p>
                </div>
              </article>
              <article>
                <span>03</span>
                <div>
                  <h3>Límit d’accessibilitat</h3>
                  <p>És una combinació reservada al logotip i a símbols grans. No s’ha d’emprar per a text de lectura ni controls d’interfície.</p>
                </div>
              </article>

              <div class="negative-color-spec" aria-label="Colors de la versió negativa">
                <div>
                  <i class="swatch-pink" aria-hidden="true"></i>
                  <span>Fons</span>
                  <strong>#EF7EAD</strong>
                </div>
                <div>
                  <i class="swatch-white" aria-hidden="true"></i>
                  <span>Marca</span>
                  <strong>#FFFFFF</strong>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section principles-section" aria-labelledby="principles-title">
          <div class="section-intro">
            <p class="eyebrow">Principis</p>
            <h2 id="principles-title">Una mateixa manera de ser.</h2>
          </div>
          <div class="principle-grid">
            <article>
              <span>01</span>
              <h3>Humana</h3>
              <p>Parlam de persones, no d'expedients. La tecnologia acompanya i mai ocupa el centre.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Precisa</h3>
              <p>La informació important és visible, verificable i fàcil de comprendre.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Calmada</h3>
              <p>Reduïm renou visual i tensió fins i tot en els fluxos més operatius.</p>
            </article>
            <article>
              <span>04</span>
              <h3>Confiable</h3>
              <p>Els estats, permisos i conseqüències sempre són explícits i previsibles.</p>
            </article>
          </div>
        </section>

        <section class="section" id="foundations" aria-labelledby="foundations-title">
          <div class="section-intro split">
            <div>
              <p class="eyebrow">Foundations</p>
              <h2 id="foundations-title">El sistema sota la superfície.</h2>
            </div>
            <p>
              Els mateixos rols semàntics adopten valors diferents en cada ruta.
              Així podem comparar el caràcter sense alterar la jerarquia.
            </p>
          </div>

          <div class="foundation-block">
            <div class="block-heading">
              <span>01</span>
              <div>
                <h3>Color</h3>
                <p>Light i dark es dissenyen com a parella, no com una inversió automàtica.</p>
              </div>
            </div>
            <div class="token-groups">
              {
                tokenGroups.map((group) => (
                  <article class="token-group">
                    <h4>{group.title}</h4>
                    {group.tokens.map((token) => (
                      <div class="color-token">
                        <i style={`background:var(${token.variable})`}></i>
                        <span>
                          <strong>{token.name}</strong>
                          <code data-token={token.variable}>—</code>
                        </span>
                      </div>
                    ))}
                  </article>
                ))
              }
            </div>
          </div>

          <div class="foundation-grid">
            <article class="foundation-card type-foundation">
              <div class="block-heading compact">
                <span>02</span>
                <div>
                  <h3>Tipografia</h3>
                  <p>Jerarquia clara, llenguatge pròxim i dades estables.</p>
                </div>
              </div>
              <div class="type-specimen">
                <span>Display / 64</span>
                <strong>Acompanyam</strong>
                <span>Title / 28</span>
                <h4>La teva jornada</h4>
                <span>Body / 16</span>
                <p>Informació clara per prendre decisions amb tranquil·litat.</p>
                <span>Data / 14</span>
                <code>08:30 · 128 visites · 96%</code>
              </div>
            </article>

            <article class="foundation-card">
              <div class="block-heading compact">
                <span>03</span>
                <div>
                  <h3>Espai i forma</h3>
                  <p>Escala de 4 punts amb densitat adaptada al context.</p>
                </div>
              </div>
              <div class="spacing-specimen">
                {[4, 8, 12, 16, 24, 32, 48, 64].map((space) => (
                  <div>
                    <span>{space}</span>
                    <i style={`width:${space}px`}></i>
                  </div>
                ))}
              </div>
              <div class="radius-specimen">
                <div><i class="radius-small"></i><span>Small</span></div>
                <div><i class="radius-medium"></i><span>Medium</span></div>
                <div><i class="radius-large"></i><span>Large</span></div>
              </div>
            </article>
          </div>
        </section>

        <section class="section components-section" id="components" aria-labelledby="components-title">
          <div class="section-intro split">
            <div>
              <p class="eyebrow">Components</p>
              <h2 id="components-title">El caràcter en ús.</h2>
            </div>
            <p>
              No són paquets d'implementació. Són espècimens visuals per decidir
              forma, densitat, contrast i comportament.
            </p>
          </div>

          <div class="component-grid">
            <article class="component-panel actions-panel">
              <div class="panel-label"><span>Accions</span><code>Buttons</code></div>
              <div class="component-row">
                <button class="button primary" type="button">
                  <Plus size={17} aria-hidden="true" /> Nova visita
                </button>
                <button class="button secondary" type="button">Acció secundària</button>
                <button class="button ghost" type="button">Acció subtil</button>
                <button class="icon-button" type="button" aria-label="Més opcions">
                  <Ellipsis size={19} />
                </button>
              </div>
              <div class="component-row states">
                <button class="button primary hover-demo" type="button">Hover</button>
                <button class="button primary pressed-demo" type="button">Pressed</button>
                <button class="button primary" type="button" disabled>Disabled</button>
              </div>
            </article>

            <article class="component-panel">
              <div class="panel-label"><span>Camps</span><code>Inputs</code></div>
              <label class="field">
                <span>Cercar persona</span>
                <div class="input-control">
                  <Search size={17} aria-hidden="true" />
                  <input type="text" value="Servei domiciliari" aria-label="Cercar persona" />
                </div>
                <small>Cerca per nom, identificador o zona.</small>
              </label>
              <label class="field">
                <span>Línia de servei</span>
                <button class="select-control" type="button">
                  SAD · Atenció domiciliària
                  <ChevronDown size={17} aria-hidden="true" />
                </button>
              </label>
            </article>

            <article class="component-panel">
              <div class="panel-label"><span>Estats</span><code>Feedback</code></div>
              <div class="badge-row">
                <span class="badge success"><Check size={13} /> Confirmada</span>
                <span class="badge warning"><Clock3 size={13} /> Pendent</span>
                <span class="badge danger"><TriangleAlert size={13} /> Revisar</span>
                <span class="badge info"><ShieldCheck size={13} /> Validada</span>
              </div>
              <div class="inline-alert">
                <TriangleAlert size={19} aria-hidden="true" />
                <div>
                  <strong>Falta una assignació</strong>
                  <p>La visita de les 10:00 encara no té professional assignat.</p>
                </div>
                <button type="button">Resoldre</button>
              </div>
            </article>

            <article class="component-panel">
              <div class="panel-label"><span>Selecció</span><code>Controls</code></div>
              <div class="control-list">
                <label><input type="checkbox" checked /> Mostrar visites confirmades</label>
                <label><input type="checkbox" /> Incloure cancel·lades</label>
                <label class="switch-row">
                  <span><strong>Notificacions</strong><small>Avisos operatius importants</small></span>
                  <input class="switch" type="checkbox" checked aria-label="Activar notificacions" />
                </label>
              </div>
            </article>
          </div>
        </section>

        <section class="section product-section" id="admin" aria-labelledby="admin-title">
          <div class="section-intro split">
            <div>
              <p class="eyebrow">Producte · Admin</p>
              <h2 id="admin-title">Densitat sense renou.</h2>
            </div>
            <p>
              La pantalla operativa posa a prova navegació, mètriques, taula,
              estats i accions dins el mateix sistema.
            </p>
          </div>

          <div class="admin-shell">
            <aside class="admin-sidebar">
              <div class="admin-logo">
                <span class="brand-symbol mini" aria-hidden="true"><i></i></span>
                <strong>ARRELS360</strong>
              </div>
              <nav>
                <a class="active" href="#admin"><LayoutDashboard size={17} /> Visió general</a>
                <a href="#admin"><CalendarDays size={17} /> Planificació</a>
                <a href="#admin"><Users size={17} /> Persones</a>
                <a href="#admin"><HeartHandshake size={17} /> Serveis</a>
                <a href="#admin"><MessageCircle size={17} /> Incidències <i>7</i></a>
                <a href="#admin"><FileText size={17} /> Informes</a>
              </nav>
              <div class="admin-sidebar-bottom">
                <a href="#admin"><CircleQuestionMark size={17} /> Ajuda</a>
                <a href="#admin"><Settings size={17} /> Configuració</a>
              </div>
            </aside>

            <div class="admin-workspace">
              <header class="admin-topbar">
                <button class="mobile-menu" type="button" aria-label="Obrir navegació"><Menu size={18} /></button>
                <div class="admin-search"><Search size={17} /><span>Cercar a ARRELS360</span><kbd>⌘ K</kbd></div>
                <div class="admin-user">
                  <button class="icon-button" type="button" aria-label="Notificacions"><Bell size={18} /><i></i></button>
                  <span class="avatar">MC</span>
                  <span><strong>Coordinació</strong><small>Zona Mallorca</small></span>
                  <ChevronDown size={15} />
                </div>
              </header>

              <div class="admin-content">
                <div class="page-heading">
                  <div>
                    <p>Dijous, 24 de juliol</p>
                    <h3>Bon dia, equip.</h3>
                    <span>Activitat operativa d'avui</span>
                  </div>
                  <button class="button primary" type="button"><Plus size={17} /> Nova visita</button>
                </div>

                <div class="metric-grid">
                  <article>
                    <span>Visites planificades <Activity size={16} /></span>
                    <strong>128</strong>
                    <small class="positive">↑ 6,4% <i>respecte d'ahir</i></small>
                  </article>
                  <article>
                    <span>En curs <Clock3 size={16} /></span>
                    <strong>24</strong>
                    <small class="neutral">Sense incidències actives</small>
                  </article>
                  <article>
                    <span>Cobertura <ShieldCheck size={16} /></span>
                    <strong>96<span>%</span></strong>
                    <small class="positive">4 serveis per assignar</small>
                  </article>
                  <article>
                    <span>Per revisar <TriangleAlert size={16} /></span>
                    <strong>07</strong>
                    <small class="warning-text">2 d'alta prioritat</small>
                  </article>
                </div>

                <article class="data-card">
                  <div class="data-card-header">
                    <div>
                      <h4>Planificació d'avui</h4>
                      <p>Visites, assignacions i estat operatiu.</p>
                    </div>
                    <div>
                      <button class="button secondary compact" type="button">Filtres <i>2</i></button>
                      <button class="icon-button" type="button" aria-label="Més opcions"><Ellipsis size={18} /></button>
                    </div>
                  </div>
                  <div class="table-wrap">
                    <table>
                      <thead>
                        <tr>
                          <th>Hora</th>
                          <th>Servei</th>
                          <th>Zona</th>
                          <th>Professional</th>
                          <th>Estat</th>
                          <th><span class="visually-hidden">Accions</span></th>
                        </tr>
                      </thead>
                      <tbody>
                        {schedule.map((item) => (
                          <tr>
                            <td><strong>{item.time}</strong></td>
                            <td>{item.service}</td>
                            <td><MapPin size={14} /> {item.zone}</td>
                            <td><span class="tiny-avatar">{item.worker.slice(-2)}</span>{item.worker}</td>
                            <td><span class={`badge ${item.tone}`}><i></i>{item.state}</span></td>
                            <td><button type="button" aria-label={`Opcions de ${item.service}`}><Ellipsis size={17} /></button></td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <div class="table-footer">
                    <span>Mostrant 4 de 128 visites</span>
                    <div><button type="button" disabled>Anterior</button><button type="button">Següent</button></div>
                  </div>
                </article>
              </div>
            </div>
          </div>
        </section>

        <section class="section key-screens-section" id="key-screens" aria-labelledby="key-screens-title">
          <div class="section-intro split">
            <div>
              <p class="eyebrow">Producte · Fluxos clau</p>
