    </footer>

    <script>
      import { spanishTranslations } from "../scripts/translations";

      const root = document.documentElement;
      const routeNames: Record<string, Record<string, string>> = {
        ca: {
          roots: "Arrels humanes",
          future: "Precisió futura",
          "future-rose": "Precisió rosa",
        },
        es: {
          roots: "Raíces humanas",
          future: "Precisión futura",
          "future-rose": "Precisión rosa",
        },
      };
      const originalText = new WeakMap<Text, string>();
      const originalAttributes = new WeakMap<Element, Map<string, string>>();
      const translatedAttributes = ["aria-label", "title", "alt", "value", "content"];
      const originalDocumentTitle = document.title;

      function normalized(value: string) {
        return value.replace(/\s+/g, " ").trim();
      }

      function applyLanguage(language: string) {
        const selectedLanguage = language === "es" ? "es" : "ca";
        root.dataset.language = selectedLanguage;
        root.lang = selectedLanguage;
        document.title = selectedLanguage === "es"
          ? spanishTranslations[originalDocumentTitle] || originalDocumentTitle
          : originalDocumentTitle;

        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        let node = walker.nextNode() as Text | null;
        while (node) {
          const source = originalText.get(node) ?? node.data;
          if (!originalText.has(node)) originalText.set(node, source);
          const key = normalized(source);
          if (key) {
            const leading = source.match(/^\s*/)?.[0] ?? "";
            const trailing = source.match(/\s*$/)?.[0] ?? "";
            const translated = spanishTranslations[key];
            node.data = selectedLanguage === "es" && translated
              ? `${leading}${translated}${trailing}`
              : source;
          }
          node = walker.nextNode() as Text | null;
        }

        document.querySelectorAll("*").forEach((element) => {
          let sources = originalAttributes.get(element);
          if (!sources) {
            sources = new Map();
            originalAttributes.set(element, sources);
          }
          translatedAttributes.forEach((attribute) => {
            const current = element.getAttribute(attribute);
            if (current === null) return;
            if (!sources?.has(attribute)) sources?.set(attribute, current);
            const source = sources?.get(attribute) ?? current;
            const translated = spanishTranslations[normalized(source)];
            element.setAttribute(
              attribute,
              selectedLanguage === "es" && translated ? translated : source,
            );
          });
        });
      }

      function paintTokenValues() {
        const styles = getComputedStyle(root);
        document.querySelectorAll("[data-token]").forEach((element) => {
          const variable = element.getAttribute("data-token");
          if (variable) element.textContent = styles.getPropertyValue(variable).trim();
        });
      }

      function syncControls() {
        const route = root.dataset.route || "future-rose";
        const mode = root.dataset.mode || "light";
        const language = root.dataset.language === "es" ? "es" : "ca";
        document.querySelectorAll("[data-route-option]").forEach((button) => {
          const selected = button.getAttribute("data-route-option") === route;
          button.classList.toggle("active", selected);
          button.setAttribute("aria-pressed", String(selected));
        });
        document.querySelectorAll("[data-language-option]").forEach((button) => {
          const selected = button.getAttribute("data-language-option") === language;
          button.classList.toggle("active", selected);
          button.setAttribute("aria-pressed", String(selected));
        });
        document.querySelectorAll("[data-current-route]").forEach((node) => {
          node.textContent = routeNames[language][route] || routeNames[language]["future-rose"];
        });
        document.querySelectorAll("[data-current-mode]").forEach((node) => {
          node.textContent = mode === "dark"
            ? language === "es" ? "oscuro" : "fosc"
            : language === "es" ? "claro" : "clar";
        });
        document.querySelectorAll("[data-current-language]").forEach((node) => {
          node.textContent = language.toUpperCase();
        });
        document.querySelector(".mode-toggle")?.setAttribute(
          "aria-pressed",
          String(mode === "dark"),
        );
        requestAnimationFrame(paintTokenValues);
      }

      document.querySelectorAll("[data-route-option]").forEach((button) => {
        button.addEventListener("click", () => {
          const route = button.getAttribute("data-route-option");
          if (!route) return;
          root.dataset.route = route;
          localStorage.setItem("arrels-route", route);
          syncControls();
        });
      });

      document.querySelector(".mode-toggle")?.addEventListener("click", () => {
        const mode = root.dataset.mode === "dark" ? "light" : "dark";
        root.dataset.mode = mode;
        localStorage.setItem("arrels-mode", mode);
        syncControls();
      });

      document.querySelectorAll("[data-language-option]").forEach((button) => {
        button.addEventListener("click", () => {
          const language = button.getAttribute("data-language-option") === "es" ? "es" : "ca";
          localStorage.setItem("arrels-language", language);
          applyLanguage(language);
          syncControls();
        });
      });

      applyLanguage(root.dataset.language || "ca");
      syncControls();
    </script>
  </body>
</html>
