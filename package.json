{
  "name": "arrels-design-system-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/docs",
    "packages/tokens"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @arrels/design-docs",
    "build": "npm run build --workspace @arrels/design-docs",
    "build:pages": "npm run build:pages --workspace @arrels/design-docs",
    "preview": "npm run preview --workspace @arrels/design-docs",
    "check": "npm run check:tokens && npm run check:docs",
    "check:docs": "npm run check --workspace @arrels/design-docs",
    "check:tokens": "node tooling/generate-flutter-tokens.mjs --check",
    "generate": "node tooling/generate-flutter-tokens.mjs"
  }
}
